rules_version = '2';

// Regras de segurança do Cloud Storage.
// Imagens de post ficam em: post-images/{userId}/{arquivo}
// Somente o dono envia/apaga. Leitura é pública porque as URLs são usadas
// nas prévias e nos posts publicados nas redes sociais.
service firebase.storage {
  match /b/{bucket}/o {

    match /post-images/{userId}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Todo o resto bloqueado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
